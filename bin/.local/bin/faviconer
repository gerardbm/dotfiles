#!/usr/bin/env bash
# Version: 1.0.2
# Date: 2026/08/08
# Modified for Debian 13
#
# Description: Generate favicons for websites

# Require exactly one argument
if [ "$#" -ne 1 ]; then
	echo "Usage: $0 <svg-file>"
	exit 1
fi

ICON_PATH="$PWD/$1"

# Check that the file exists
if [ ! -f "$ICON_PATH" ]; then
	echo "Error: file not found: $1" >&2
	exit 1
fi

# Check that the file has an SVG extension
case "${ICON_PATH##*.}" in
	svg|SVG)
			;;
	*)
			echo "Error: input file must be an SVG: $1" >&2
			exit 1
			;;
esac

ICON_BASE=$(basename "$ICON_PATH")
ICON_FILE="${ICON_BASE%.*}"

FAVICON_FILE="favicon"

echo -n "HEX color for msapplication-TileColor: "
read -r tilecolor

echo -n "Name for Manifest App: "
read -r wmname

echo -n "Short name for Manifest App: "
read -r wmshortname

echo -n "HEX color for Manifest theme: "
read -r wmthemecolor

echo -n "HEX color for Manifest background: "
read -r wmbgcolor

mkdir -p icons
cd icons || exit

# This uses rsvg-convert to create crisp PNG icons
for size in 16 32 48 150 180 192 512; do
	ICON_OUT="$ICON_FILE-${size}.png"
	DIMENSIONS="${size}x${size}"

	# Convert SVG to PNG at the requested size
	rsvg-convert \
			-w "$size" \
			-h "$size" \
			"$ICON_PATH" > "$ICON_OUT"

	# Center the image and make it square
	magick "$ICON_OUT" \
			-alpha on \
			-gravity center \
			-background none \
			-resize "$DIMENSIONS" \
			-extent "$DIMENSIONS" \
			"temp-$ICON_OUT"

	# Reduce file size using 8-bit colour
	pngquant 256 \
			--output "$FAVICON_FILE-$DIMENSIONS.png" \
			"temp-$ICON_OUT"
done

# MERGE ICO FILE
# Instead of mergin small files, under Debian 13 we get the temporal 512x512
# to generate an ICO containing all the needed resolutions (16, 32 and 48),
# it will resize the images with an automatic antialias
magick "temp-$ICON_FILE-512.png" \
	-background none \
	-define icon:auto-resize=48,32,16 \
	"$FAVICON_FILE.ico"
mv "$FAVICON_FILE.ico" ..

# Create Apple icons
mv "$FAVICON_FILE-180x180.png" apple-touch-icon.png

# Create Android icons
mv "$FAVICON_FILE-192x192.png" android-chrome-192x192.png
mv "$FAVICON_FILE-512x512.png" android-chrome-512x512.png

# Create MS tile icon
mv "$FAVICON_FILE-150x150.png" mstile-150x150.png

# Create Safari icon
cp "$ICON_PATH" safari-pinned-tab.svg
sed -i -e 's/fill:#.\{6\}/fill:#000000/g' safari-pinned-tab.svg

# Clean up the temporary files
rm -f \
    "$ICON_FILE-16.png" \
    "$ICON_FILE-32.png" \
    "$ICON_FILE-48.png" \
    "$ICON_FILE-150.png" \
    "$ICON_FILE-180.png" \
    "$ICON_FILE-192.png" \
    "$ICON_FILE-512.png"

rm -f temp-"$ICON_FILE"-*.png

# 48x48 is only needed temporarily for favicon.ico
rm -f "$FAVICON_FILE-48x48.png"

# Create Browserconfig file
cat > browserconfig.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
    <msapplication>
        <tile>
            <square150x150logo src="/icons/mstile-150x150.png"/>
            <TileColor>$tilecolor</TileColor>
        </tile>
    </msapplication>
</browserconfig>
EOF

# Create Webmanifest file
cat > site.webmanifest <<EOF
{
    "name": "$wmname",
    "short_name": "$wmshortname",
    "icons": [
        {
            "src": "/icons/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icons/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "theme_color": "$wmthemecolor",
    "background_color": "$wmbgcolor",
    "display": "standalone"
}
EOF

cd ..

cat > favicons.html <<EOF
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
<link rel="manifest" href="/icons/site.webmanifest" />
<link rel="mask-icon" color="#ffffff" href="/icons/safari-pinned-tab.svg" />
<meta name="msapplication-config" content="/icons/browserconfig.xml" />
EOF
